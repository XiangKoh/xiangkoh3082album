  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Keshi Album | design WengXiang A1",
        "meta_descr": "This page explores the sonic and emotional world of keshi — a space where vulnerability meets minimalism.\nThrough each album, keshi crafts intimate stories of love, loss, and self-reflection, blending lo-fi textures with haunting vocals.\n\nFrom soft acoustic confessions to atmospheric R&B soundscapes, every project captures a different phase of his journey — both as an artist and as a person.\n\nThis collection invites you to experience not just music, but emotion in its purest form.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/2026-04-06-1.55.19-1.png"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
